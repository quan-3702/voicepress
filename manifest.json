{
  "name": "VoicePress - Audiobook Maker & Text to Speech",
  "short_name": "VoicePress",
  "description": "Turn Word, PDF, EPUB and text files into MP3 audiobooks with natural AI voices that run on your own PC. 30+ languages, works offline.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#b45309",
